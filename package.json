{
	"name": "auto-beautiful-mermaid",
	"version": "1.2.2",
	"description": "Render the diagram types beautiful-mermaid supports with beautiful-mermaid; leave every other Mermaid type to Obsidian's built-in renderer.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint . && stylelint styles.css"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"mermaid",
		"beautiful-mermaid"
	],
	"author": "rxdxxxx",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/rxdxxxx/obsidian-auto-beautiful-mermaid.git"
	},
	"dependencies": {
		"beautiful-mermaid": "^1.1.3",
		"pele": "^1.12.0"
	},
	"devDependencies": {
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"@types/node": "^20.11.0",
		"@vitest/coverage-v8": "^4.1.9",
		"esbuild": "^0.20.0",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jsdom": "^29.1.1",
		"obsidian": "^1.5.7",
		"stylelint": "^17.16.0",
		"tslib": "^2.6.2",
		"typescript": "^5.4.0",
		"vitest": "^4.1.9"
	}
}
